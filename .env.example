# Copy this file to .env for local development, and add the same keys to your
# hosting provider's environment settings for deployments.
#
# NOTE: the app loads .env in every environment, but real environment variables
# always win — so a platform dashboard value is never overwritten by this file.

# --- MongoDB (required) ---
# Must be a real connection string. For Atlas remember to allow your IP
# (or 0.0.0.0/0 when the host's egress IP is dynamic).
ATLASDB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/wanderlust?retryWrites=true&w=majority
# ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust

# --- Session secret (required) ---
SECRET=change-me-to-a-long-random-string

# --- Cloudinary (optional: required only for image uploads) ---
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# --- Server ---
# NODE_ENV=production
# PORT=8080

# --- Seeding (optional, used by `npm run seed`) ---
# SEED_USERNAME=demo
# SEED_PASSWORD=wanderlust123
# SEED_EMAIL=demo@wanderlust.local
